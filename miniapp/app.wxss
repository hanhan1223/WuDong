/* 全局样式 - 设计规范变量 */
page {
  /* 品牌色 */
  --color-primary: #1f5fa8;
  --color-primary-dark: #0e3d75;
  --color-primary-light: #e8f1fb;
  --color-orange: #e85d2f;
  --color-green: #6b8e3d;
  --color-gold: #d4a14b;

  /* 中性色 */
  --color-text: #1a1a1a;
  --color-text-secondary: #595959;
  --color-text-tertiary: #8c8c8c;
  --color-border: #e5e5e5;
  --color-bg: #f7f8fa;
  --color-bg-white: #ffffff;

  /* 功能色 */
  --color-success: #52c41a;
  --color-warning: #faad14;
  --color-error: #ff4d4f;

  /* 苗族文化色 */
  --color-indigo: #1a3a5c;
  --color-silver: #c0c0c0;
  --color-terrace: #6b8e3d;
  --color-wood: #7a5230;

  /* 品牌色阴影 */
  --shadow-brand: 0 4px 12px rgba(31, 95, 168, 0.2);

  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg);
  font-family:
    "Alibaba PuHuiTi", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei",
    sans-serif;
  box-sizing: border-box;
}

/* 通用工具类 */
.container {
  padding: 24rpx 32rpx;
}

.card {
  background: var(--color-bg-white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.text-primary {
  color: var(--color-primary);
}

.text-orange {
  color: var(--color-orange);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-tertiary {
  color: var(--color-text-tertiary);
}

.text-bold {
  font-weight: 600;
}

.text-center {
  text-align: center;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-sm {
  font-size: 24rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.mt-sm {
  margin-top: 16rpx;
}
.mt-md {
  margin-top: 24rpx;
}
.mb-sm {
  margin-bottom: 16rpx;
}
.mb-md {
  margin-bottom: 24rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag-primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-orange {
  background: #fff1ea;
  color: var(--color-orange);
}

/* 价格样式 */
.price {
  color: var(--color-orange);
  font-weight: 600;
}

.price-symbol {
  font-size: 24rpx;
}

.price-original {
  color: var(--color-text-tertiary);
  text-decoration: line-through;
  font-size: 24rpx;
  margin-left: 8rpx;
}
