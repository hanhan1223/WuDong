/* pages/dining/detail.wxss */
.page {
  padding-bottom: 120rpx;
  background: var(--color-bg);
}

.cover-img {
  width: 100%;
  height: 400rpx;
}

.info {
  margin-top: -20rpx;
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
  z-index: 1;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.rating {
  color: var(--color-gold);
}

.addr,
.time {
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.intro {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-top: 12rpx;
}

.section {
  margin-top: 16rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.dish-list {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.dish-item {
  flex-shrink: 0;
  width: 200rpx;
}

.dish-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.dish-name {
  display: block;
  font-size: 26rpx;
  margin-bottom: 4rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.picker-value {
  padding: 16rpx 24rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.slot-tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.slot-tag.active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.counter {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.counter-btn {
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.counter-value {
  font-size: 32rpx;
  font-weight: 500;
  min-width: 48rpx;
  text-align: center;
}

.form-input {
  padding: 16rpx 24rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}

.book-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: none;
}

.book-btn::after {
  border: none;
}
