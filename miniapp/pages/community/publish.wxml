<!--pages/community/publish.wxml-->
<view class="page">
  <view class="form">
    <!-- 标题 -->
    <input
      class="title-input"
      placeholder="添加标题，让更多人看到"
      maxlength="50"
      value="{{title}}"
      bind:input="onTitleInput"
    />

    <!-- 内容 -->
    <textarea
      class="content-input"
      placeholder="分享你的旅行故事..."
      maxlength="5000"
      value="{{content}}"
      bind:input="onContentInput"
      auto-height
    />

    <!-- 图片 -->
    <view class="image-grid">
      <view class="image-item" wx:for="{{images}}" wx:key="*this">
        <image class="preview-img" src="{{item}}" mode="aspectFill" />
        <view class="remove-btn" bind:tap="onRemoveImage" data-idx="{{index}}">×</view>
      </view>
      <view wx:if="{{images.length < 9}}" class="add-image" bind:tap="onChooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>

    <!-- 关联地点 -->
    <view class="form-item">
      <text class="form-label">关联地点（选填）</text>
      <input
        class="form-input"
        placeholder="输入地点名称"
        value="{{locationName}}"
        bind:input="onLocationInput"
      />
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="submit-area">
    <button class="submit-btn" loading="{{loading}}" bind:tap="onSubmit">发布</button>
  </view>
</view>
