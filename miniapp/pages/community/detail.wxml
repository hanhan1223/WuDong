<!--pages/community/detail.wxml-->
<view class="page" wx:if="{{post}}">
  <!-- 作者信息 -->
  <view class="author-bar">
    <image class="author-avatar" src="{{post.user.avatar}}" mode="aspectFill" />
    <view class="author-info">
      <text class="author-name">{{post.user.nickname}}</text>
      <text class="post-time text-tertiary">{{post.createdAt}}</text>
    </view>
    <view class="follow-btn {{post.isFollowed ? 'followed' : ''}}" bind:tap="onFollow">
      {{post.isFollowed ? '已关注' : '+ 关注'}}
    </view>
  </view>

  <!-- 内容 -->
  <view class="content-section">
    <text class="post-title">{{post.title}}</text>
    <text class="post-content">{{post.content}}</text>

    <!-- 图片 -->
    <view class="image-grid" wx:if="{{post.images && post.images.length > 0}}">
      <image
        class="post-image {{post.images.length === 1 ? 'single' : post.images.length === 4 ? 'four' : ''}}"
        wx:for="{{post.images}}"
        wx:key="*this"
        src="{{item}}"
        mode="aspectFill"
        bind:tap="previewImage"
        data-src="{{item}}"
      />
    </view>
  </view>

  <!-- 互动栏 -->
  <view class="action-bar">
    <view class="action-item {{post.isLiked ? 'active' : ''}}" bind:tap="onLike">
      <text>{{post.isLiked ? '❤️' : '🤍'}}</text>
      <text>{{post.likeCount}}</text>
    </view>
    <view class="action-item">
      <text>💬</text>
      <text>{{post.commentCount}}</text>
    </view>
    <view class="action-item">
      <text>⭐</text>
      <text>{{post.favoriteCount}}</text>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comment-section">
    <text class="section-title">评论 ({{post.commentCount}})</text>

    <view class="comment-list">
      <view class="comment-item" wx:for="{{comments}}" wx:key="id">
        <image class="comment-avatar" src="{{item.user.avatar}}" mode="aspectFill" />
        <view class="comment-body">
          <text class="comment-name">{{item.user.nickname}}</text>
          <text class="comment-text">{{item.content}}</text>
          <view class="comment-meta">
            <text class="comment-time text-tertiary">{{item.createdAt}}</text>
            <text class="reply-btn text-tertiary" bind:tap="onReplyTap" data-comment="{{item}}">回复</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{comments.length === 0}}" class="empty-comments">
      <text class="text-tertiary">暂无评论，快来抢沙发吧~</text>
    </view>
  </view>

  <!-- 评论输入框 -->
  <view class="comment-input-bar">
    <view class="reply-hint" wx:if="{{replyTo}}" bind:tap="cancelReply">
      <text>回复 {{replyTo.user.nickname}}</text>
      <text>×</text>
    </view>
    <view class="input-wrap">
      <input
        class="comment-input"
        placeholder="{{replyTo ? '回复 ' + replyTo.user.nickname : '写评论...'}}"
        value="{{commentText}}"
        bind:input="onCommentInput"
        confirm-type="send"
        bind:confirm="onSubmitComment"
      />
      <view class="send-btn" bind:tap="onSubmitComment">发送</view>
    </view>
  </view>
</view>
