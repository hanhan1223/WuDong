/* pages/community/index.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.sort-item {
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  border-radius: 999rpx;
  margin-right: 16rpx;
}

.sort-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 500;
}

/* 游记卡片 */
.post-list {
  padding: 16rpx 32rpx;
}

.post-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.post-user {
  flex: 1;
}

.post-nickname {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.post-time {
  font-size: 22rpx;
}

.post-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--color-text);
}

.post-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.6;
}

/* 图片网格 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.post-image.single {
  width: 400rpx;
  height: 300rpx;
}

/* 互动栏 */
.post-actions {
  display: flex;
  gap: 48rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.action-item {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(31, 95, 168, 0.3);
  font-size: 40rpx;
  z-index: 100;
}

.empty-tip,
.loading-tip {
  text-align: center;
  padding: 80rpx 0;
}
