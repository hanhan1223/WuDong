<!--pages/login/index.wxml-->
<view class="page">
  <view class="logo-area">
    <view class="logo">
      <text class="logo-text">乌东文旅</text>
    </view>
    <text class="logo-desc">苗寨有银，文化有纹</text>
  </view>

  <view class="form-area">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bind:input="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">密码</text>
      <input
        class="form-input"
        type="text"
        password
        placeholder="请输入密码（至少8位）"
        value="{{password}}"
        bind:input="onPasswordInput"
      />
    </view>

    <view wx:if="{{mode === 'register'}}" class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        placeholder="请输入昵称"
        value="{{nickname}}"
        bind:input="onNicknameInput"
      />
    </view>

    <button
      class="submit-btn"
      loading="{{loading}}"
      bind:tap="onSubmit"
    >
      {{mode === 'login' ? '登录' : '注册'}}
    </button>

    <view class="switch-mode" bind:tap="switchMode">
      <text class="text-tertiary">
        {{mode === 'login' ? '没有账号？' : '已有账号？'}}
      </text>
      <text class="text-primary">
        {{mode === 'login' ? '立即注册' : '去登录'}}
      </text>
    </view>
  </view>
</view>
