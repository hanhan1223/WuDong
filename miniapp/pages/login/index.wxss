/* pages/login/index.wxss */
.page {
  min-height: 100vh;
  background: #fff;
  padding: 0 48rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1f5fa8, #0e3d75);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.logo-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.form-area {
  padding: 0 16rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--color-primary);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  margin-top: 48rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.switch-mode {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-top: 32rpx;
  font-size: 26rpx;
}
