/* pages/message/index.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.message-list {
  padding: 16rpx 32rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.msg-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.msg-content {
  flex: 1;
  overflow: hidden;
}

.msg-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.msg-text {
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.msg-time {
  font-size: 22rpx;
}

.unread-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-error);
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.loading-tip {
  text-align: center;
  padding: 40rpx 0;
}
