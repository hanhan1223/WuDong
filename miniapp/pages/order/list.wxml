<!--pages/order/list.wxml-->
<view class="page">
  <!-- Tab 切换 -->
  <scroll-view class="tab-bar" scroll-x>
    <view
      class="tab-item {{currentTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bind:tap="onTabChange"
      data-tab="{{item.key}}"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view
      class="order-card card"
      wx:for="{{orders}}"
      wx:key="id"
      bind:tap="onOrderTap"
      data-id="{{item.id}}"
    >
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="order-status {{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="orderItem">
          <image class="item-img" src="{{orderItem.productImage}}" mode="aspectFill" />
          <view class="item-info">
            <text class="item-name text-ellipsis">{{orderItem.productName}}</text>
            <text class="item-spec text-tertiary" wx:if="{{orderItem.skuName}}">{{orderItem.skuName}}</text>
          </view>
          <view class="item-right">
            <text class="item-price">¥{{orderItem.price}}</text>
            <text class="item-qty text-tertiary">x{{orderItem.quantity}}</text>
          </view>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-total">合计: <text class="price">¥{{item.totalAmount}}</text></text>
      </view>
    </view>

    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-tip">
      <text class="empty-icon">📦</text>
      <text class="text-tertiary">暂无订单</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">
    <text class="text-tertiary">加载中...</text>
  </view>
</view>
