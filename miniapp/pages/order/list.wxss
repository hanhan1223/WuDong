/* pages/order/list.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.tab-bar {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
  padding: 0 16rpx;
}

.tab-item {
  display: inline-block;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.order-list {
  padding: 16rpx 32rpx;
}

.order-card {
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-status.PENDING_PAYMENT {
  color: var(--color-warning);
}
.order-status.PAID {
  color: var(--color-primary);
}
.order-status.CONFIRMED {
  color: var(--color-primary);
}
.order-status.IN_PROGRESS {
  color: var(--color-green);
}
.order-status.COMPLETED {
  color: var(--color-success);
}
.order-status.CANCELLED {
  color: var(--color-text-tertiary);
}
.order-status.REFUNDING {
  color: var(--color-orange);
}
.order-status.REFUNDED {
  color: var(--color-text-tertiary);
}

.order-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  overflow: hidden;
}

.item-name {
  display: block;
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.item-spec {
  font-size: 24rpx;
}

.item-right {
  text-align: right;
  flex-shrink: 0;
}

.item-price {
  display: block;
  font-size: 28rpx;
}

.item-qty {
  font-size: 24rpx;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
  margin-top: 12rpx;
}

.order-total {
  font-size: 26rpx;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.loading-tip {
  text-align: center;
  padding: 40rpx 0;
}
