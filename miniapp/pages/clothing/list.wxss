/* pages/clothing/list.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.category-bar {
  white-space: nowrap;
  padding: 16rpx 32rpx;
  background: #fff;
}

.category-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  color: var(--color-text-secondary);
}

.category-tag.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 500;
}

.sort-bar {
  display: flex;
  padding: 16rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 0;
}

.sort-item.active {
  color: var(--color-primary);
  font-weight: 500;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.product-card {
  width: calc(50% - 8rpx);
  padding: 0;
  overflow: hidden;
  margin-bottom: 0;
}

.product-image {
  width: 100%;
  height: 340rpx;
}

.product-info {
  padding: 16rpx 20rpx;
}

.product-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
  height: 72rpx;
  line-height: 36rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.sales {
  font-size: 22rpx;
}

.loading-tip {
  text-align: center;
  padding: 32rpx 0;
}
