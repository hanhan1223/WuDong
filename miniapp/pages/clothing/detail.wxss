/* pages/clothing/detail.wxss */
.page {
  padding-bottom: 120rpx;
  background: var(--color-bg);
}

.product-swiper {
  height: 750rpx;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-info {
  margin: -20rpx 0 0;
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
  z-index: 1;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.product-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.product-subtitle {
  display: block;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.product-meta {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
}

.sku-section,
.craft-section,
.artisan-section,
.detail-section {
  margin-top: 16rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sku-tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.sku-tag.active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.craft-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.artisan-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.artisan-story {
  font-size: 26rpx;
  line-height: 1.8;
}

.detail-content {
  font-size: 26rpx;
  line-height: 1.8;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-left {
  display: flex;
  gap: 32rpx;
  margin-right: 24rpx;
}

.bottom-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 36rpx;
}

.icon-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.bottom-right {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.btn-cart {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 999rpx;
  font-size: 28rpx;
  background: #fff;
  padding: 0;
}

.btn-cart::after {
  border: none;
}

.btn-buy {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
  padding: 0;
}

.btn-buy::after {
  border: none;
}
