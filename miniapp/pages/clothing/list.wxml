<!--pages/clothing/list.wxml-->
<view class="page">
  <!-- 分类标签 -->
  <scroll-view class="category-bar" scroll-x>
    <view
      class="category-tag {{currentCategory === 0 ? 'active' : ''}}"
      bind:tap="onCategoryTap"
      data-id="0"
    >全部</view>
    <view
      class="category-tag {{currentCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      bind:tap="onCategoryTap"
      data-id="{{item.id}}"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view class="sort-item {{sort === 'default' ? 'active' : ''}}" bind:tap="onSortTap" data-sort="default">综合</view>
    <view class="sort-item {{sort === 'sales' ? 'active' : ''}}" bind:tap="onSortTap" data-sort="sales">销量</view>
    <view class="sort-item {{sort === 'price_asc' ? 'active' : ''}}" bind:tap="onSortTap" data-sort="price_asc">价格↑</view>
    <view class="sort-item {{sort === 'price_desc' ? 'active' : ''}}" bind:tap="onSortTap" data-sort="price_desc">价格↓</view>
  </view>

  <!-- 商品列表 -->
  <view class="product-grid">
    <view
      class="product-card card"
      wx:for="{{products}}"
      wx:key="id"
      bind:tap="onProductTap"
      data-id="{{item.id}}"
    >
      <image class="product-image" src="{{item.mainImage}}" mode="aspectFill" />
      <view class="product-info">
        <text class="product-title text-ellipsis">{{item.title}}</text>
        <view class="product-bottom">
          <text class="price"><text class="price-symbol">¥</text>{{item.price}}</text>
          <text class="sales text-tertiary">已售{{item.sales}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">
    <text class="text-tertiary">加载中...</text>
  </view>
  <view wx:if="{{!hasMore && products.length > 0}}" class="loading-tip">
    <text class="text-tertiary">没有更多了</text>
  </view>
</view>
