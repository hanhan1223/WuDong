/* pages/homestay/list.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.search-bar {
  margin: 16rpx 32rpx;
  padding: 20rpx;
}

.search-row {
  display: flex;
  gap: 24rpx;
}

.search-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
}

.search-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.search-value {
  font-size: 28rpx;
  font-weight: 500;
}

.homestay-list {
  padding: 0 32rpx;
}

.homestay-card {
  margin-bottom: 20rpx;
  padding: 0;
  overflow: hidden;
}

.homestay-img {
  width: 100%;
  height: 360rpx;
}

.homestay-info {
  padding: 20rpx;
}

.homestay-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.homestay-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.homestay-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rating {
  color: var(--color-gold);
  font-size: 26rpx;
}

.loading-tip {
  text-align: center;
  padding: 40rpx 0;
}
