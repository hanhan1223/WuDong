/* pages/user/index.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 用户头部 */
.user-header {
  display: flex;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #1f5fa8, #0e3d75);
}

.avatar-wrap {
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-default {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.arrow {
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}

/* 订单区 */
.section {
  margin: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.order-tabs {
  display: flex;
  justify-content: space-around;
}

.order-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tab-icon {
  font-size: 40rpx;
}

.tab-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-name {
  font-size: 28rpx;
  color: var(--color-text);
}

/* 退出登录 */
.logout-btn {
  margin: 48rpx 32rpx;
  padding: 24rpx;
  text-align: center;
  background: #fff;
  border-radius: 12rpx;
  color: var(--color-error);
  font-size: 28rpx;
}
