<!--pages/category/index.wxml-->
<view class="page">
  <view class="header">
    <text class="title">全部分类</text>
    <text class="subtitle">探索乌东文旅</text>
  </view>

  <view class="module-list">
    <view
      class="module-card card"
      wx:for="{{modules}}"
      wx:key="id"
      bind:tap="onModuleTap"
      data-path="{{item.path}}"
    >
      <view class="module-icon" style="background: {{item.color}}20;">
        <text class="icon-emoji">{{item.icon}}</text>
      </view>
      <view class="module-info">
        <text class="module-name">{{item.name}}</text>
        <text class="module-desc text-tertiary">{{item.desc}}</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>
</view>
