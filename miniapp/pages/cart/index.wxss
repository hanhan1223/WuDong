/* pages/cart/index.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
}

.cart-list {
  padding: 16rpx 32rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  overflow: hidden;
}

.item-name {
  display: block;
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.item-spec {
  display: block;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.qty-value {
  font-size: 28rpx;
  min-width: 40rpx;
  text-align: center;
}

.delete-btn {
  margin-left: 12rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  margin-right: 24rpx;
}

.total {
  flex: 1;
  font-size: 26rpx;
}

.total-price {
  font-size: 32rpx;
}

.checkout-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  border: none;
  padding: 0;
}

.checkout-btn::after {
  border: none;
}
