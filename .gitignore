# ====================
# 依赖目录
# ====================
node_modules/
.pnp/
.pnp.js

# ====================
# 环境变量（含敏感信息）
# ====================
.env
.env.local
.env.*.local
!.env.example

# ====================
# 构建产物
# ====================
dist/
build/
out/
*.js.map

# ====================
# 日志
# ====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ====================
# 测试覆盖率
# ====================
coverage/
.nyc_output/

# ====================
# Prisma 生成文件
# ====================
server/prisma/migrations/**/migration_lock.toml

# ====================
# IDE / 编辑器
# ====================
.vscode/
.idea/
*.swp
*.swo
*~

# ====================
# 操作系统
# ====================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ====================
# Docker 数据卷
# ====================
docker/data/
mysql-data/
redis-data/

# ====================
# SSL 证书（本地开发用）
# ====================
docker/nginx/ssl/*.pem
docker/nginx/ssl/*.key
docker/nginx/ssl/*.crt

# ====================
# 微信小程序
# ====================
miniapp/node_modules/
miniapp/dist/
miniapp/.miniprogram/

# ====================
# 临时文件
# ====================
*.tmp
*.temp
.cache/
